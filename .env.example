# ============================================================
# 시설 인력 관리 앱 — 환경 변수 템플릿
# ------------------------------------------------------------
# 이 파일을 .env.local 로 복사한 뒤 각 값을 채울 것.
#   cp .env.example .env.local
# .env.local 은 절대 커밋하지 말 것 (.gitignore 처리됨).
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 확인
# 필수: 없으면 빌드 자체가 실패함 (src/lib/supabase-server.ts)

# 프로젝트 URL (형식: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public 키 — 브라우저에 노출되는 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 — RLS를 우회하므로 절대 클라이언트에 노출 금지
# 서버 컴포넌트 / API Route 에서만 사용됨
SUPABASE_SERVICE_ROLE_KEY=

# ── PostgreSQL 직접 연결 (선택) ──────────────────────────────
# Supabase SQL Editor 로 마이그레이션을 돌린다면 채우지 않아도 됨.
# scripts/migrate.mjs 를 쓸 때만 필요 (별도로 `npm i -D pg` 필요).
# Supabase 대시보드 → Project Settings → Database 에서 확인
DATABASE_URL=
DATABASE_PASSWORD=

# ── JWT 서명 키 ─────────────────────────────────────────────
# 세션 쿠키 서명에 사용 (src/lib/auth.ts)
# 32자 이상 랜덤 문자열. 아래 명령으로 생성 가능:
#   openssl rand -base64 32
# 미설정 시 개발용 fallback 값이 쓰이므로 운영 환경에서는 반드시 설정할 것.
JWT_SECRET=
